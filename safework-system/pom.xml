<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.safework</groupId>
        <artifactId>safework</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>safework-system</artifactId>
    <description>系统模块：平台（企业、套餐）、部门、用户、登录安全、角色、菜单权限、日志</description>

    <dependencies>
        <dependency>
            <groupId>com.safework</groupId>
            <artifactId>safework-common</artifactId>
        </dependency>
        <!-- 操作日志切面 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!-- 验证码、登录失败计数、在线用户都存在 Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
