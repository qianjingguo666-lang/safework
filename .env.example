# 复制为 .env 后修改（.env 已加入 .gitignore，不会提交）
# 密码只用字母和数字，避免特殊符号在命令行里出问题

# 数据库 root 密码
MYSQL_ROOT_PASSWORD=ChangeMe123mysql
# Redis 密码
REDIS_PASSWORD=ChangeMe123redis

# 对外端口：服务器上用 80；本机测试如果 80 被占用，改成 8088
WEB_PORT=80

# AI（可选）：DeepSeek
AI_CHAT_BASE_URL=https://api.deepseek.com
AI_CHAT_API_KEY=
AI_CHAT_MODEL=deepseek-chat
# 向量模型（可选）：阿里云百炼
AI_EMBEDDING_API_KEY=

# 后端内存：2G 内存的服务器保持默认；4G 可以改成 -Xms512m -Xmx1024m
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC
