<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.safework</groupId>
        <artifactId>safework</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>safework-server</artifactId>
    <description>启动模块：组装各业务模块，打成可运行 jar</description>

    <dependencies>
        <dependency>
            <groupId>com.safework</groupId>
            <artifactId>safework-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.safework</groupId>
            <artifactId>safework-safety</artifactId>
        </dependency>
        <dependency>
            <groupId>com.safework</groupId>
            <artifactId>safework-ticket</artifactId>
        </dependency>
        <dependency>
            <groupId>com.safework</groupId>
            <artifactId>safework-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>safework-server</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
